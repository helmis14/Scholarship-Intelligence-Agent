            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>image/epsf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Egyptian President, Gamal Abdul Nasser (1918-1970) speaks in Damascus at ceremonies to mark the second anniversary of the merger of Syria and Egypt to form the United Arab Republic. The union broke up the following year.   (Photo by Keystone/Getty Images)</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Keystone</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:title>
