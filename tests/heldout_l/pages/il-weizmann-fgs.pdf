      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>image/epsf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Britain's new Prime Minister Margaret Thatcher, leader of the Conservative Party, waves outside number 10 Downing Street in London, England, May 5, 1979.  Thatcher is the first woman to serve in this position.  (AP Photo)</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">BRITAIN THATCHER FIRST WOMAN PM</rdf:li>
