      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>image/epsf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">U.S. investor Warren Buffett, second right, shakes hands with Israeli industrialist Stef Wertheimer, right, the founder of Iscar Metalworking Co., Eitan Wertheimer, second left, the Chairman of Board, and Charlie Munger, Vice-Chairman of Berkshire Hathaway, left, in Tefen, northern Israel, Monday, Sept. 18, 2006. In his biggest investment outside the U.S., Buffett paid four billion US (three billion euro) for an 80 percent stake in Iscar Metalworking Co. (AP Photo/Sebastian Scheiner)</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>SEBASTIAN SCHEINER</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">MIDEAST ISRAEL BUFFETT</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">AP2006</rdf:li>
            </rdf:Alt>
         </dc:rights>
