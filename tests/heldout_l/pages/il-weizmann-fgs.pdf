      <rdf:Description rdf:about=""
            xmlns:xapMM="http://ns.adobe.com/xap/1.0/mm/">
         <xapMM:DocumentID>adobe:docid:photoshop:c92aefe8-3e0a-11dd-8978-b662629c1ce4</xapMM:DocumentID>
         <xapMM:InstanceID>uuid:c92aefe9-3e0a-11dd-8978-b662629c1ce4</xapMM:InstanceID>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>image/epsf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">An audience watches as Garry Kasparov is shown on a television screen contemplating his next move against Deep Blue, IBM's chess playing computer, during the second game of their six game rematch, Sunday, May 4, 1997, in New York.  It was Man 1, Machine 0, after world chess champion Kasparov won the first game of the rematch on Saturday. (AP Photo/Adam Nadel)</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>ADAM NADEL</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:title>
            <rdf:Alt>
