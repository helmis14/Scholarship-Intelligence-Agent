            <rdf:Seq>
               <rdf:li>NASSER NASSER</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">MIDEAST ISRAEL PALESTINIANS</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:rights>
