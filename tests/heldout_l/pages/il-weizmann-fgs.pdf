            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>image/epsf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Reigning chess world champion Boris Spassky of the U.S.S. R., left, and international grandmaster Bobby Fischer of the United States, right, are seen during a game at the XIX World Chess Olympiad, in Siegen, Germany, on September 20, 1970.  (AP Photo/Heinz Ducklau)</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>HEINZ DUCKLAU</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">SPASSKY FISCHER CHESS OLYMPIAD</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:rights>
