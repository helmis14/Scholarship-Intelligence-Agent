         <photoshop:History/>
         <photoshop:CaptionWriter>XCJ PDS TH SAV</photoshop:CaptionWriter>
         <photoshop:Instructions>UNITED KINGDOM OUT.</photoshop:Instructions>
         <photoshop:AuthorsPosition>STR</photoshop:AuthorsPosition>
         <photoshop:Credit>ASSOCIATED PRESS</photoshop:Credit>
         <photoshop:Source>AP</photoshop:Source>
         <photoshop:City>EDINBURGH</photoshop:City>
         <photoshop:Country>XSC</photoshop:Country>
         <photoshop:TransmissionReference>LON112</photoshop:TransmissionReference>
         <photoshop:Category>I</photoshop:Category>
         <photoshop:DateCreated>1997-11-30</photoshop:DateCreated>
         <photoshop:Urgency>4</photoshop:Urgency>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:tiff="http://ns.adobe.com/tiff/1.0/">
         <tiff:Orientation>1</tiff:Orientation>
