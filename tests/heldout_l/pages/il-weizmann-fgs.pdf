         <photoshop:Headline>PLANE WORLD TRADE TOWER</photoshop:Headline>
         <photoshop:Instructions>A SEPT. 11, 2001 FILE PHOTO.</photoshop:Instructions>
         <photoshop:AuthorsPosition>STR</photoshop:AuthorsPosition>
