      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>image/epsf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Mother Teresa, left, says goodbye to Princess Diana after receiving a visit from her Wednesday, June 18, 1997, in New York.  Princess Diana met privately for 40 minutes with Mother Teresa at The Missionaries of Charity in the South Bronx section of New York.  (AP Photo/Bebeto Matthews)</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
