         <xapMM:DocumentID>adobe:docid:photoshop:7decb45f-3c81-11dd-a475-8a63a8694a89</xapMM:DocumentID>
         <xapMM:InstanceID>uuid:7decb460-3c81-11dd-a475-8a63a8694a89</xapMM:InstanceID>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>image/epsf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Boris Pasternak, the controversial poet and novelist, faces reporters in his Moscow apartment in 1958, after hearing that he had been awarded the Nobel Prize for Literature for "Dr. Zhivago". The novel was not published in Russia and at Pasternak`s funeral in 1960, a young dissident schouted, "It was a great book he wrote. It`s a pity they won`t let us read it". (AP-Photo)</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">PASTERNAK</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">AP1958</rdf:li>
            </rdf:Alt>
         </dc:rights>
      </rdf:Description>
   </rdf:RDF>
