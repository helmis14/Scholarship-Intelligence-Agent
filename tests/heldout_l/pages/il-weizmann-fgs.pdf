         <photoshop:Headline>WARHOL</photoshop:Headline>
         <photoshop:Credit>Associated Press</photoshop:Credit>
         <photoshop:Source>AP</photoshop:Source>
         <photoshop:City>LONDON</photoshop:City>
         <photoshop:Country>GBR XEN</photoshop:Country>
         <photoshop:TransmissionReference>APHS221</photoshop:TransmissionReference>
         <photoshop:Category>I</photoshop:Category>
         <photoshop:DateCreated>1971-02-15</photoshop:DateCreated>
         <photoshop:Urgency>4</photoshop:Urgency>
