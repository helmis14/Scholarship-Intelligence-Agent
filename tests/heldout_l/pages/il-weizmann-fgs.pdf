         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Portrait of French scientist Luc Montagnier, discoverer of the AIDS virus, 13 May 2003 in Hamburg, where he takes part in a German-Austrian AIDS-symposium, 20 years after the discovery of the deadly virus.   AFP PHOTO DDP / ROLAND MAGUNIA          GERMANY OUT</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>ROLAND MAGUNIA</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">GERMANY-AIDS-MONTAGNIER</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">ImageForum</rdf:li>
            </rdf:Alt>
         </dc:rights>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>VERTICAL</rdf:li>
               <rdf:li>PORTRAIT</rdf:li>
               <rdf:li>AIDS</rdf:li>
               <rdf:li>PERSON-MEDICINE</rdf:li>
            </rdf:Bag>
         </dc:subject>
