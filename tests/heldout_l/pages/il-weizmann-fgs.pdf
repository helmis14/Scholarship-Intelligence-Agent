      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>image/epsf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">An Israeli army tank and an armed personnel carrier move into Palestinian leader Yasser Arafat's compound in the West Bank town of Ramallah Friday, March 29, 2002. Israeli troops stormed Arafat's headquarters Friday in response to anti-Israeli attacks that killed 30 civilians in three days. (AP Photo/Nasser Nasser)</rdf:li>
            </rdf:Alt>
