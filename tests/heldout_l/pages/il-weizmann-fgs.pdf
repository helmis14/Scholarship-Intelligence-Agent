            xmlns:xap="http://ns.adobe.com/xap/1.0/">
         <xap:CreateDate>2008-06-15T15:35:13+03:00</xap:CreateDate>
         <xap:ModifyDate>2008-06-15T15:35:13+03:00</xap:ModifyDate>
         <xap:MetadataDate>2008-06-15T15:35:13+03:00</xap:MetadataDate>
