      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>image/epsf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">An aerial view of the Chernobyl nucler power plant, the site of the world's worst nuclear accident, is seen in April 1986, made two to three days after the explosion in Chernobyl, Ukraine.  In front of the chimney is the destroyed 4th reactor.   (AP Photo)</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>STR</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">CHERNOBYL DISASTER 1986</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">AP1986</rdf:li>
            </rdf:Alt>
         </dc:rights>
      </rdf:Description>
