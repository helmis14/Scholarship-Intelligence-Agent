      <rdf:Description rdf:about=""
            xmlns:xapMM="http://ns.adobe.com/xap/1.0/mm/">
         <xapMM:DocumentID>adobe:docid:photoshop:e0c14aa4-3e0d-11dd-8978-b662629c1ce4</xapMM:DocumentID>
         <xapMM:InstanceID>uuid:e0c14aa5-3e0d-11dd-8978-b662629c1ce4</xapMM:InstanceID>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>image/epsf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Photo taken on Wednesday,  May 21, 2003 shows part of the Three Gorges Dam Project in Yichang in central China's Hubei Province. The dam gates of the three Gorges Hydropower Project on the Yangtze River will be closed for storing water behind the dam on June 1. 2003.  By June 15, the water level is expected to reach 135 meters, and by June 16, navigation will start on a trial basis according to the official schedule. The appraisal group for the project examined the project on the work site on May 21 and all the dam gates and relevant facilities have been completed in accordance with the official requirements. (AP Photo /  Xinhua,   Cheng Min)</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>CHENG MIN</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">CHINA THREE GORGES</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">AP2003</rdf:li>
            </rdf:Alt>
         </dc:rights>
      </rdf:Description>
   </rdf:RDF>
