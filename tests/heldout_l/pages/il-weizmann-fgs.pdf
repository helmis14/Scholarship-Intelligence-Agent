            <rdf:Alt>
               <rdf:li xml:lang="x-default">The 3.2 million year old Australopithecus afarensis skeleton called Lucy, part of a new exhibit, is displayed during a press preview at the Houston Museum of Natural Science in Houston Tuesday, Aug. 28, 2007. The exhibit, which opens Friday, Aug. 31, marks the first time Lucy has been displayed in public outside her native Ethiopia -- a trip that has unleashed an international furor among scientists. (AP Photo / Michael Stravato)</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>MICHAEL STRAVATO</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">LUCY ON TOUR</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">AP2007</rdf:li>
            </rdf:Alt>
         </dc:rights>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>ap</rdf:li>
            </rdf:Bag>
         </dc:subject>
      </rdf:Description>
   </rdf:RDF>
</x:xmpmeta>
<?xpacket end="r"?>
endstream
endobj
