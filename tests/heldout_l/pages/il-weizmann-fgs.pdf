      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/">
         <photoshop:History/>
         <photoshop:CaptionWriter>VIF VP</photoshop:CaptionWriter>
         <photoshop:Headline>FEDERICO FELLINI ANITA EKBERG</photoshop:Headline>
         <photoshop:Instructions>B/W only, 1960 filer</photoshop:Instructions>
         <photoshop:AuthorsPosition>STR</photoshop:AuthorsPosition>
         <photoshop:Credit>ASSOCIATED PRESS</photoshop:Credit>
         <photoshop:City>ROME</photoshop:City>
         <photoshop:Country>ITA</photoshop:Country>
         <photoshop:TransmissionReference>ROM6</photoshop:TransmissionReference>
         <photoshop:Category>I</photoshop:Category>
         <photoshop:DateCreated>1993-10-18</photoshop:DateCreated>
         <photoshop:SupplementalCategories>
            <rdf:Bag>
               <rdf:li>FILE,OBIT</rdf:li>
            </rdf:Bag>
         </photoshop:SupplementalCategories>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:tiff="http://ns.adobe.com/tiff/1.0/">
         <tiff:Orientation>1</tiff:Orientation>
         <tiff:XResolution>300/1</tiff:XResolution>
         <tiff:YResolution>300/1</tiff:YResolution>
         <tiff:ResolutionUnit>2</tiff:ResolutionUnit>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:xap="http://ns.adobe.com/xap/1.0/">
         <xap:CreateDate>2008-06-15T15:26:51+03:00</xap:CreateDate>
         <xap:ModifyDate>2008-06-15T15:26:51+03:00</xap:ModifyDate>
         <xap:MetadataDate>2008-06-15T15:26:51+03:00</xap:MetadataDate>
         <xap:CreatorTool>Adobe Photoshop CS Macintosh</xap:CreatorTool>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:xapMM="http://ns.adobe.com/xap/1.0/mm/">
         <xapMM:DocumentID>adobe:docid:photoshop:c2a10610-3c81-11dd-a475-8a63a8694a89</xapMM:DocumentID>
         <xapMM:InstanceID>uuid:c2a10611-3c81-11dd-a475-8a63a8694a89</xapMM:InstanceID>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>image/epsf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">FILE -- Italian movie director Federico Fellini gives advice to Swedish actress Anita Ekberg during the filming of ''La Dolce Vita'' in 1960. In the background is Trevi Fountain where Fellini had Miss Ekberg romp in the waters with one of his favorite stars Marcello Mastroianni.  The 73-year-old director, who had been in a coma since suffering from a heart attack and respiratory problems October 17, died Sunday, October 31, 1993. (AP Photo/Dufoto)</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>DUFOTO</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">OBIT FELLINI</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">AP1993</rdf:li>
            </rdf:Alt>
         </dc:rights>
      </rdf:Description>
   </rdf:RDF>
</x:xmpmeta>
