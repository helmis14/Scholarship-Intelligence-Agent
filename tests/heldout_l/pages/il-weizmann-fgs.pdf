      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:xapMM="http://ns.adobe.com/xap/1.0/mm/">
         <xapMM:DocumentID>adobe:docid:photoshop:f9f588f8-3c82-11dd-a475-8a63a8694a89</xapMM:DocumentID>
         <xapMM:InstanceID>uuid:f9f588f9-3c82-11dd-a475-8a63a8694a89</xapMM:InstanceID>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>image/epsf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">America's pop art painter and filmmaker, Andy Warhol, stands in front of his double portrait of the late Hollywood film star, Marilyn Monroe, at The Tate Gallery in London, February 15, 1971, at a press preview of his exhibition. (AP Photo)</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">WARHOL'S MONROE</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">AP1971</rdf:li>
            </rdf:Alt>
         </dc:rights>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>ARTIST,ARTWORK,MONROE,STANDING,PAINTER,FILMAKER</rdf:li>
            </rdf:Bag>
         </dc:subject>
