      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>image/epsf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Maccabi Tel Aviv's coach Pinhas Gershon and the Captain Gur Shelef hold the Euroleague basketball trophy in Tel Aviv.  Maccabi Tel Aviv's coach Pinhas Gershon (R) and the Captain Gur Shelef (L) hold the Euroleague basketball trophy in Tel Aviv May 9, 2005. Tens of thousands of happy Israelis thronged to a Tel Aviv park on Monday evening to celebrate Maccabi Tel Aviv basketball team's second straight Euroleague championship. The perennial Israeli champion won Europe's most prestigious tournament Sunday in Moscow, defeating the team Tau Ceramica of Spain by 90-78. REUTERS/Nir Elias</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Â© Reuters Photographer / Reuters</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">SPORT</rdf:li>
            </rdf:Alt>
         </dc:title>
      </rdf:Description>
