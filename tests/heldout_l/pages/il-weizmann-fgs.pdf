         <xapMM:InstanceID>uuid:bc6f7edc-3e09-11dd-8978-b662629c1ce4</xapMM:InstanceID>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>image/epsf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The flag of the Soviet Union, left, and the flag of the Russian Republic, fly side by side over the Kremlin, in Moscow, on Dec. 21, 1991. The Soviet flag is expected to come down on New Years Eve, never to fly over the Kremlin again. (AP Photo/Staff/Zemlianichenko)</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>ALEXANDER ZEMLIANICHENKO</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">FLAGS OVER KREMLIN</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">AP1991</rdf:li>
            </rdf:Alt>
         </dc:rights>
      </rdf:Description>
