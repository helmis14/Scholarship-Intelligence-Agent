         <exif:PixelYDimension>508</exif:PixelYDimension>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/">
         <photoshop:History/>
         <photoshop:CaptionWriter>XMN LH</photoshop:CaptionWriter>
         <photoshop:Headline>Pope Paul VI</photoshop:Headline>
         <photoshop:AuthorsPosition>STF</photoshop:AuthorsPosition>
         <photoshop:Credit>AP</photoshop:Credit>
         <photoshop:Source>AP</photoshop:Source>
         <photoshop:City>Pisa</photoshop:City>
         <photoshop:Country>ITA</photoshop:Country>
         <photoshop:TransmissionReference>APHSM</photoshop:TransmissionReference>
         <photoshop:Category>I</photoshop:Category>
         <photoshop:DateCreated>1965-06-10</photoshop:DateCreated>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:tiff="http://ns.adobe.com/tiff/1.0/">
         <tiff:Orientation>1</tiff:Orientation>
         <tiff:XResolution>300/1</tiff:XResolution>
         <tiff:YResolution>300/1</tiff:YResolution>
         <tiff:ResolutionUnit>2</tiff:ResolutionUnit>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:xap="http://ns.adobe.com/xap/1.0/">
         <xap:CreateDate>2008-06-15T15:42:10+03:00</xap:CreateDate>
         <xap:ModifyDate>2008-06-15T15:42:10+03:00</xap:ModifyDate>
         <xap:MetadataDate>2008-06-15T15:42:10+03:00</xap:MetadataDate>
         <xap:CreatorTool>Adobe Photoshop CS Macintosh</xap:CreatorTool>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:xapMM="http://ns.adobe.com/xap/1.0/mm/">
         <xapMM:DocumentID>adobe:docid:photoshop:ebad2b1e-3c83-11dd-a475-8a63a8694a89</xapMM:DocumentID>
         <xapMM:InstanceID>uuid:ebad2b1f-3c83-11dd-a475-8a63a8694a89</xapMM:InstanceID>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>image/epsf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Pope Paul VI opens his arms in response to the cheering crowds which welcomed him on his arrival in Pisa's Square of the Miracles, during a one-day visit to the city, June 10, 1965. In the background is the famous leaning tower. The Cathedral is at left. The Pope's visit to Pisa - the first by a Pontiff in more than 100 years - was made on the occasion of the Italian National Eucharistic Congress. Close to a million persons crowded in and around the Square of the Miracles to attend the mass which the Pope celebrated there at a special outdoor altar. In an address the Pope paid tribute to Galileo, who framed his great theories of physics in the same Square, and later was denounced by the Inquisition. (Ap Photo)</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Anonymous</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Pope Paul VI</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">1965 AP </rdf:li>
            </rdf:Alt>
         </dc:rights>
      </rdf:Description>
   </rdf:RDF>
</x:xmpmeta>
<?xpacket end="r"?>
