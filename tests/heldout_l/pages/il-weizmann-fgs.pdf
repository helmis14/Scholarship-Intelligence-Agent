         <xapMM:InstanceID>uuid:7c8e971f-3e09-11dd-8978-b662629c1ce4</xapMM:InstanceID>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>image/epsf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Tim Berners-Lee, 43, director of the World Wide Web Consortium at the Massachusetts Institute of Technology in Cambridge, Mass., poses in his office Monday, June 1, 1998. Berners-Lee, a native of London, is a recipient of the 1998 MacArthur Fellowship carrying a stipend of $270,000 for his work in pioneering the World Wide Web. (AP Photo/Elise Amendola)</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>ELISE AMENDOLA</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">GENIUS GRANTS</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">AP1998</rdf:li>
            </rdf:Alt>
         </dc:rights>
      </rdf:Description>
