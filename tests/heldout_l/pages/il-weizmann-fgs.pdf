         <dc:format>image/epsf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Scientist and inventor of the laser Dr. Theodore Maiman pours liquid nitrogen into a cooling unit around one of the first experimental lasers in his laboratory in Santa Monica, Calif., on March 9, 1964.  (AP Photo)</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
