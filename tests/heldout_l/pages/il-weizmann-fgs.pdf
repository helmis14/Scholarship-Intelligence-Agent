         <tiff:YResolution>300/1</tiff:YResolution>
         <tiff:ResolutionUnit>2</tiff:ResolutionUnit>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:xap="http://ns.adobe.com/xap/1.0/">
         <xap:CreateDate>2008-06-15T15:46:22+03:00</xap:CreateDate>
         <xap:ModifyDate>2008-06-15T15:46:22+03:00</xap:ModifyDate>
         <xap:MetadataDate>2008-06-15T15:46:22+03:00</xap:MetadataDate>
         <xap:CreatorTool>Adobe Photoshop CS Macintosh</xap:CreatorTool>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:xapMM="http://ns.adobe.com/xap/1.0/mm/">
         <xapMM:DocumentID>adobe:docid:photoshop:7a6e5897-3c84-11dd-a475-8a63a8694a89</xapMM:DocumentID>
         <xapMM:InstanceID>uuid:7a6e5898-3c84-11dd-a475-8a63a8694a89</xapMM:InstanceID>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>image/epsf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Prof. Chris Barnard uses a sketch on a blackboard to illustrate a point while addressing a group of journalists in December 1967 in Redenbosch,Cape, Town, South Africa. He was explaining how he performed a heart transplant; surgical operation at Groote Schurr Hospital, Cape Town on the night of Dec.2. He transfered a heart from the boddy of a girl fatally injured in a car crash to a man suffering with an impaired heart. (AP Photo/ARG)</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>ARG</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">CHRIS BARNARD</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">AP1967</rdf:li>
            </rdf:Alt>
         </dc:rights>
      </rdf:Description>
   </rdf:RDF>
</x:xmpmeta>
<?xpacket end="r"?>
endstream
