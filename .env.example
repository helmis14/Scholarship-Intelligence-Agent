# Scholarship agent configuration. Copy to your shell profile (or a private .env you source yourself).
# Never commit real values. Empty = off.

# --- Data ------------------------------------------------------------------------------------
SCHOLAR_DATA_DIR=

# --- Web search (free, self-hosted SearXNG; see docs/scholarship-agent/SEARCH.md) -------------
SEARCH_PROVIDER=searxng            # searxng | brave | none
SEARXNG_URL=http://127.0.0.1:8080  # deploy/searxng/start.sh binds here, localhost only
BRAVE_SEARCH_API_KEY=              # only if you choose Brave (paid beyond its free tier)

# --- AI-assisted extraction --------------------------------------------------------------------
AI_PROVIDER=anthropic              # Claude is the active provider; dry run until ANTHROPIC_ALLOW_PAID=1.
                                   # gemini | ollama remain selectable but inactive; none = rules only. No fallback.
# Ollama (local): inactive, kept for compatibility
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=                      # e.g. qwythos-hermes:latest

# Anthropic Claude (paid). Nothing is sent until ANTHROPIC_ALLOW_PAID=1 AND the budgets below are > 0.
ANTHROPIC_API_KEY=                  # set in your shell only; never commit a real key
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_ALLOW_PAID=0
ANTHROPIC_MAX_REQUESTS_PER_RUN=0
ANTHROPIC_MAX_INPUT_TOKENS_PER_RUN=0
ANTHROPIC_MAX_OUTPUT_TOKENS_PER_RUN=0
ANTHROPIC_MAX_ESTIMATED_COST_USD=0
ANTHROPIC_MAX_TOTAL_COST_USD=0      # optional cap across runs in this data directory (0 = off)
ANTHROPIC_SERVER_FALLBACK=0        # 1 lets another model answer when overloaded; its price may differ
ANTHROPIC_MAX_TOKENS=4000          # per request, includes thinking
ANTHROPIC_EFFORT=low               # low | medium | high
ANTHROPIC_TIMEOUT_SECONDS=120
ANTHROPIC_MAX_RETRIES=3
ANTHROPIC_MAX_CONCURRENCY=2
# Only for model ids without a built-in price (USD per million tokens):
ANTHROPIC_PRICE_INPUT_PER_MTOK=
ANTHROPIC_PRICE_OUTPUT_PER_MTOK=

# --- Inactive providers, kept for compatibility (round 7: Claude only) ----------------------------
# Google Gemini (Gemini Developer API, official google-genai SDK; python3 -m pip install google-genai).
# A Gemini/Google One subscription is not an API key. Nothing is sent until GEMINI_ALLOW_PAID=1 AND budgets > 0
# (required on the free tier too: free-tier prompts may be used by Google to improve its products).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_ALLOW_PAID=0
GEMINI_MAX_REQUESTS_PER_RUN=0
GEMINI_MAX_INPUT_TOKENS_PER_RUN=0
GEMINI_MAX_OUTPUT_TOKENS_PER_RUN=0
GEMINI_MAX_ESTIMATED_COST_USD=0
GEMINI_MAX_TOKENS=4000             # per request, includes thinking
GEMINI_THINKING_LEVEL=low          # minimal | low | medium | high (Gemini 3+)
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=3
GEMINI_MAX_CONCURRENCY=2
GEMINI_PRICE_INPUT_PER_MTOK=
GEMINI_PRICE_OUTPUT_PER_MTOK=

# --- Reporting policy -------------------------------------------------------------------------
# Claim kinds with low measured precision are sent to review: off | standard | strict (see docs/scholarship-agent/EVALUATION.md, round 37)
SCHOLAR_RISK_GATE=standard
# 1 = the configured AI provider also reads each page on its own; any decision it reads differently is held for review
# (round 43; costs one model call per new page; see docs/scholarship-agent/EVALUATION.md)
SCHOLAR_SECOND_READING=0
